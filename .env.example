# API keys from https://api-manager.opentransportdata.swiss (free; one per API), and how much of each key this
# instance may use: calls per minute and per day (0 = no daily cap). Copy to .env; keep the real one out of git.

GTFS_RT_TOKEN=
GTFS_RT_TOKEN_HASH=
GTFS_RT_per_Minute=5
GTFS_RT_per_Day=0

GTFS_SA_TOKEN=
GTFS_SA_TOKEN_HASH=
GTFS_SA_per_Minute=5
GTFS_SA_per_Day=0

FORMATION_SERVICE_TOKEN=
FORMATION_SERVICE_TOKEN_HASH=
FORMATION_SERVICE_per_Minute=5
FORMATION_SERVICE_per_Day=0

CKAN_TOKEN=
CKAN_TOKEN_HASH=
CKAN_per_Minute=5
CKAN_per_Day=0

# Development: borrow realtime data from a running instance instead of polling with your own keys
# LIVE_FROM=https://trainnet.briggen.dev
